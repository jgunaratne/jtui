# Copy to .env and fill in. .env is gitignored; never commit real paths.
# jtui reads .env from the working directory, then ~/.jtui/.env.

# Antigravity CLI integration (only needed for `--engine antigravity`).
# Absolute path to the Antigravity CLI binary.
JTUI_ANTIGRAVITY_CLI=/path/to/antigravity-cli

# Alternatively, a colon-separated list of candidate paths to search in order.
# JTUI_ANTIGRAVITY_CLI_PATH=/opt/antigravity/bin/cli:/usr/local/bin/antigravity-cli
